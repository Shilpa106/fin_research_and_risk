# ==============================================================================
# LOCAL DEVELOPMENT CONFIGURATION
# Enterprise Financial Research & Risk Copilot
# ==============================================================================

# Application Environment
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Gateway & Networking
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
ALLOWED_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true

# Security & JWT Tokens (Local Development Secret)
JWT_SECRET_KEY=dev-insecure-secret-key-change-in-production-must-be-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Zero-Setup Local SQLite Engine)
DATABASE_URL=sqlite+aiosqlite:///./financial_copilot_dev.db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# In-Memory Cache (Redis optional in local dev)
REDIS_URL=redis://localhost:6379/0
REDIS_CLUSTER_ENABLED=false
RATE_LIMIT_RPS=10000
RATE_LIMIT_BURST=15000
SEMANTIC_CACHE_ENABLED=false

# OpenSearch (Optional in local mock/sqlite mode)
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_CHUNKS=enterprise_financial_chunks_v1

# AWS Bedrock Foundation Models
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_ROUTER_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Observability
OTEL_SERVICE_NAME=financial-research-copilot
PROMETHEUS_METRICS_ENABLED=true
