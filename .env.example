# ==============================================================================
# ENTERPRISE FINANCIAL RESEARCH & RISK COPILOT CONFIGURATION
# WARNING: NEVER COMMIT PRODUCTION CREDENTIALS OR REAL API KEYS TO GIT
# ==============================================================================

# Application Environment (development | staging | production | test)
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Gateway & Networking
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true

# Security & Multi-Tenancy (Rotate in production via AWS Secrets Manager / KMS)
JWT_SECRET_KEY=replace-with-a-secure-random-256-bit-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/tenant-master-key

# Database (PostgreSQL with Row Level Security)
# For local dev without Postgres: sqlite+aiosqlite:///./financial_copilot_dev.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_password@localhost:5432/financial_copilot_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Redis (Caching, Rate Limiting & Semantic Cache)
REDIS_URL=redis://localhost:6379/0
REDIS_CLUSTER_ENABLED=false
RATE_LIMIT_RPS=10000
RATE_LIMIT_BURST=15000
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.96

# OpenSearch Cluster (1B+ Chunks Hybrid Retrieval)
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=AdminDevPassword123!
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_CHUNKS=enterprise_financial_chunks_v1

# AWS Bedrock Foundation Models & Guardrails
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_ROUTER_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_GUARDRAIL_ID=gr-financial-compliance-01
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Model Context Protocol (MCP) Endpoints
MCP_SEC_EDGAR_URL=http://localhost:8001
MCP_MARKET_DATA_URL=http://localhost:8002

# Observability & Metrics
OTEL_SERVICE_NAME=financial-research-copilot
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_METRICS_ENABLED=true
